# Python cache/bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/

# PyInstaller spec file
*.spec

# Ignore test directories but allow test files
**/tests/
**/test/

# Test and coverage outputs
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checker / linters
.mypy_cache/
.ruff_cache/

# IDE/editor settings
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp

# Local secrets/config
.env
.env.*
*.pem
*.key
*.p12
*.pfx
